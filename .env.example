# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Get this from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Comma-separated Telegram usernames or user IDs that can talk to the bot.
# Leave blank to allow anyone.
ALLOWED_USERS=

# Comma-separated numeric Telegram user IDs allowed to run admin text commands (e.g. set ratio 70/30).
# Leave blank to disallow blend changes via chat.
# ADMIN_USER_IDS=123456789

# Path to the tanya_brain vault (defaults to ../tanya_brain relative to this script)
# VAULT_PATH=/Users/colewannemacher/Desktop/moms auto/tanya_brain

# Get this from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Tanya's cloned voice
ELEVENLABS_VOICE_ID=JZWiJzVBxv3K7zOcItDy

# Stripe Payment Link URL (included in free-trial closing message when set; "yes" after close can send it again)
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxxxxx
# Neutral URL if live link unset (not a checkout; set empty to skip and use text-only soft message instead)
# STRIPE_PAYMENT_LINK_PLACEHOLDER=https://stripe.com

# After the 25-message free trial, block further coaching until paid or MESH (default on). Set 0 to allow all (dev only).
# BLOCK_AFTER_FREE_TRIAL=1
# Comma-separated Telegram user IDs that may coach after trial without Stripe (testing / internal).
# POST_TRIAL_ALLOW_CHAT_IDS=

# Claude model to use
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Log approximate USD per coaching message to the server log (tokens always logged).
# Set to 0 to disable the dollar line. Override prices (per 1M tokens) to match anthropic.com/pricing.
# LOG_SESSION_COST_USD=1
# ANTHROPIC_PRICE_INPUT_PER_MTOK=3
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15
# ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=0.30
# ANTHROPIC_PRICE_CACHE_WRITE_PER_MTOK=3.75

# Easy USD view: in Telegram send /cost or /usage after a message. A spreadsheet
# logs/tanya_usage.csv is written under Communication Device (open in Excel / Numbers).

# Seconds from anchor clock before sending each coaching reply (default 10). Keep at 10 for live trial pacing.
# Optional: lower value only for local dev pacing checks (then restore 10).
# RESPONSE_DELAY_SECONDS=10
