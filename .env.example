# Blooio iMessage API
BLOOIO_API_KEY=your-blooio-api-key-here
BLOOIO_WEBHOOK_SECRET=your-blooio-webhook-secret-here
BLOOIO_PHONE_NUMBER=+13177282783

# Comma-separated E.164 phone numbers allowed to run admin commands.
# Leave blank to disable admin commands.
# ADMIN_PHONE_NUMBERS=+12065551234

# Comma-separated E.164 phone numbers that may coach after trial without Stripe (testing / internal).
# POST_TRIAL_BYPASS_PHONES=

# Get this from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Path to the tanya_brain vault (defaults to ../tanya_brain relative to this script)
# VAULT_PATH=/Users/colewannemacher/Desktop/moms auto/tanya_brain

# Get this from elevenlabs.io/app/settings/api-keys (code kept; not sent over iMessage)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Tanya's cloned voice
ELEVENLABS_VOICE_ID=JZWiJzVBxv3K7zOcItDy

# Stripe Payment Link URL (sent when client confirms after free trial; optional until billing is live)
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# STRIPE_PORTAL_LINK=https://billing.stripe.com/...
# STRIPE_TOPUP_LINK=https://buy.stripe.com/...

# After the 25-message free trial, block further coaching until paid (default on). Set 0 to allow all (dev only).
# BLOCK_AFTER_FREE_TRIAL=1

# Claude model to use
# CLAUDE_MODEL=claude-sonnet-4-6

# Log approximate USD per coaching message to the server log (tokens always logged).
# Set to 0 to disable the dollar line. Override prices (per 1M tokens) to match anthropic.com/pricing.
# LOG_SESSION_COST_USD=1
# ANTHROPIC_PRICE_INPUT_PER_MTOK=3
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15
# ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=0.30
# ANTHROPIC_PRICE_CACHE_WRITE_PER_MTOK=3.75

# Seconds from anchor clock before sending each coaching reply (default 10).
# RESPONSE_DELAY_SECONDS=10

# Port for the FastAPI/uvicorn server (default 8080; Railway sets this automatically).
# PORT=8080
